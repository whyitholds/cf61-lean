import Std

set_option maxHeartbeats 0
set_option maxRecDepth 100000

def ppCmp (u v : Nat) := if u < v then 0 else if u = v then 1 else 2
def ppUp (f u v : Nat) := if u=v then f else ppCmp u v
def ppHU (x : Fin 3) : Nat := if x.val = 1 then 1 else 0
def ppHV (x : Fin 3) : Nat := if x.val = 2 then 1 else 0
def ppLetter (s : Nat) (x y : Fin 3) :=
  2*((s/18 + ppHU x + ppHU y)%2) + (s/9%2 + ppHV x + ppHV y)%2
def ppCol (s : Nat) (x y : Fin 3) :=
  18*((s/18 + ppHU x + ppHU y)/2) + 9*((s/9%2 + ppHV x + ppHV y)/2) +
  3*ppUp (s/3%3) (ppHU x) (ppHV x) + ppUp (s%3) (ppHU y) (ppHV y)

