def ppTagged (a s : Nat) : List PPMove := (ppTaggedData[a]!)[s]!

def ppChecks (a s : Nat) : Bool :=
  decide ((ppTagged a s).map Prod.fst = (ppIncoming[a]!)[s]!) &&
  decide (ppTagged a s).Nodup &&
  (ppTagged a s).all (fun x => decide (x.1 < 72 ∧ ppLetter x.1 x.2.1 x.2.2 = a ∧
      ppCol x.1 x.2.1 x.2.2 = s))

theorem ppOK : ∀ a : Fin 4, ∀ s : Fin 72, ppChecks a s = true := by
  decide +kernel

theorem ppCover : ∀ i : Fin 72, ∀ x y : Fin 3,
    (i.val,x,y) ∈ ppTagged (ppLetter i x y) (ppCol i x y) := by
  decide +kernel

