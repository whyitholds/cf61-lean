def pfWStepAt (v : Nat) (a s : Nat) : Nat :=
  pfPackedClamp (((pfWIncoming[a]!)[s]!).foldl (fun n i => n + pfCol v i) 0)

def pfWTransition (first : Bool) (v : Nat) (a : Nat) (w : Nat) : Bool :=
  ((List.range 72).all fun s => pfWStepAt v a s == (pfCol w s)) &&
  (pfFlagA first a (pfCol v 72) == (pfCol w 72)) && (pfFlagV a (pfCol v 73) == (pfCol w 73))

def pfWAcceptCount (v : Nat) (ah d r : Nat) : Nat :=
  (pfWWeights[16*ah+4*d+r]!).foldl (fun acc p => acc + pfDigit (pfCol v p.1) p.2.1 * p.2.2) 0

def pfWGood (v : Nat) : Bool :=
  (List.range 32).all fun i =>
    let count := pfWAcceptCount v (i/16) (i/4%4) (i%4)
    !pfAllowed v (i/16) (i/4%4) || (count != 2 && count != 3)
