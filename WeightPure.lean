abbrev PWChoice := (Fin 3 × Fin 3) × (Fin 6 × Fin 6)

def pwAll : List PWChoice :=
  (List.finRange 3).flatMap fun a => (List.finRange 3).flatMap fun b =>
    (List.finRange 6).flatMap fun x => (List.finRange 6).map fun y => ((a,b),(x,y))

def pwFit (f : Nat) (t : Fin 6) : Bool :=
  decide (t.val ≤ 1 ∨ (t.val = 2 ∧ f ≤ 1) ∨ (t.val = 3 ∧ f = 0) ∨ (4 ≤ t.val ∧ f = 2))

def pwShift (t : Fin 6) : Nat := #[3,2,2,4,1,1][t.val]!
def pwResidue (t : Fin 6) : Nat := #[1,2,0,0,1,3][t.val]!

def pwRule (ah d r j e c b f g : Nat) (T : PWChoice) : Bool :=
  let A := T.1.1
  let B := T.1.2
  let x := T.2.1
  let y := T.2.2
  let u := if A.val=1 then 1 else 0
  let v := if A.val=2 then 1 else 0
  let U := if B.val=1 then 1 else 0
  let V := if B.val=2 then 1 else 0
  let cmp (p q z : Nat) := if p=q then z else (if p<q then 0 else if p=q then 1 else 2)
  pwFit (cmp u v f) x && pwFit (cmp U V g) y &&
    decide (c+u+U=ah) && decide (b+v+V+pwShift x+pwShift y=d+4*j) &&
    decide (pwResidue x+pwResidue y=r+4*e)

def pwWeight (q s t : Nat) : Nat :=
  (pwTable[q]!.map fun p => if p.1 = s ∧ p.2.1 = t then p.2.2 else 0).sum

def pwCheck (q s t : Nat) : Bool :=
  pwWeight q s t == pwAll.countP (pwRule (q/16) (q/4%4) (q%4) (t/2) (t%2)
    (s/18) (s/9%2) (s/3%3) (s%3))
